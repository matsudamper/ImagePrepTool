{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/*"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin\\.plugin\\.serialization(?:[.:]|$)/",
        "io.gitlab.arturbosch.detekt",
        "io.nlopez.compose.rules:detekt",
        "/^org\\.jetbrains\\.compose(?:[.:]|$)/",
        "/^org\\.jetbrains\\.androidx(?:[.:]|$)/"
      ],
      "automerge": true
    }
  ]
}
