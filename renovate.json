{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/*",
        "gradle/actions"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "gradle-wrapper"
      ],
      "automerge": true
    },
    {
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin(?:[.:]|$)/",
        "/^org\\.jetbrains\\.kotlinx(?:[.:]|$)/",
        "io.gitlab.arturbosch.detekt",
        "io.nlopez.compose.rules:detekt",
        "/^org\\.jetbrains\\.compose(?:[.:]|$)/",
        "/^org\\.jetbrains\\.androidx(?:[.:]|$)/"
      ],
      "automerge": true
    }
  ]
}
